#!/bin/sh
# Prepare the commit message: strip AI co-authorship, then add Signed-off-by.
# Runs once per commit, zero friction.

# Remove AI attribution trailers (keeps human co-authors). Fail-open.
if command -v node >/dev/null 2>&1; then
  node "$(git rev-parse --show-toplevel)/scripts/hooks/scrubber-precommit.js" "$1" 2>/dev/null || true
fi

NAME=$(git config user.name)
EMAIL=$(git config user.email)
if [ -z "$NAME" ] || [ -z "$EMAIL" ]; then
  exit 0
fi
SOB="Signed-off-by: $NAME <$EMAIL>"
if ! grep -qF "$SOB" "$1"; then
  printf '\n%s\n' "$SOB" >> "$1"
fi
