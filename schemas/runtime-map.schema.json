{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EGC Runtime Map Schema",
  "description": "Topology cache that scripts/runtime/discovery.js writes to internal/registry/runtime-map.json from the install manifests",
  "type": "object",
  "required": ["generatedAt", "profiles", "modules", "components"],
  "additionalProperties": false,
  "properties": {
    "generatedAt": { "type": "string", "format": "date-time" },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "description", "moduleCount"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "moduleCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "kind", "description", "targets", "defaultInstall", "cost", "stability", "dependencyCount"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string" },
          "description": { "type": "string" },
          "targets": { "type": "array", "items": { "type": "string" } },
          "defaultInstall": { "type": "boolean" },
          "cost": { "type": "string" },
          "stability": { "type": "string" },
          "dependencyCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "family", "description", "moduleIds", "moduleCount", "targets"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "family": { "type": "string" },
          "description": { "type": "string" },
          "moduleIds": { "type": "array", "items": { "type": "string" } },
          "moduleCount": { "type": "integer", "minimum": 0 },
          "targets": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
