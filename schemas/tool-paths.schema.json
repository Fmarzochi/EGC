{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EGC install paths per tool",
  "type": "object",
  "required": [
    "version",
    "description",
    "checkedOn",
    "variants",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "checkedOn": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "platform",
          "env"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_=-]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "enum": [
              "linux",
              "darwin",
              "win32"
            ]
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "adapters": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "adapter",
          "surface",
          "path",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "adapter": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "surface": {
            "type": "string",
            "pattern": "^[a-z-]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^(~|<project>|\\$[A-Z_]+)(/[^\\s]*)?$"
          },
          "status": {
            "type": "string",
            "enum": [
              "documented",
              "egc",
              "unverified"
            ]
          },
          "source": {
            "type": "string",
            "pattern": "^https://[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+(/[^\\s]*)?$"
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "variant": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "documented"
                }
              }
            },
            "then": {
              "required": [
                "source"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "egc"
                }
              }
            },
            "then": {
              "required": [
                "note"
              ],
              "not": {
                "required": [
                  "source"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "unverified"
                }
              }
            },
            "then": {
              "required": [
                "note"
              ]
            }
          }
        ]
      }
    }
  }
}
